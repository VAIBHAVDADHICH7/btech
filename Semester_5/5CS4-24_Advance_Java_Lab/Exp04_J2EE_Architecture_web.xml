<!-- Module 4: J2EE N-Tier Web Application Deployment Descriptor (WEB-INF/web.xml) -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
    <display-name>RTU Advance Java Enterprise App</display-name>
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>Exp05_LoginServletAndFilter</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
</web-app>
